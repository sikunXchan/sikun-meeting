{
  "name": "sikun-meeting",
  "productName": "Sikun Meeting",
  "version": "0.8.7",
  "description": "AIチームに依頼し、会議から成果物まで進めるワークスペース",
  "private": true,
  "main": "dist/main/index.js",
  "author": "sikunlily",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.js && node scripts/sync-mobile-assets.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@modelcontextprotocol/client": "^2.1.0",
    "@openai/codex-sdk": "^0.156.1",
    "exceljs": "^4.4.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.sikunlily.sikunmeeting",
    "productName": "Sikun Meeting",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/@anthropic-ai/claude-agent-sdk*/**",
      "**/claude.exe",
      "**/@openai/codex*/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/claude.exe",
          "to": "claude.exe"
        },
        {
          "from": "node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc",
          "to": "codex-runtime"
        }
      ],
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
